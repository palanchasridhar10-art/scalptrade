# ==========================================
# DELTA EXCHANGE INDIA CONFIGURATION
# ==========================================
# Execution Mode: DEMO (India Testnet) | LIVE (India Production) | PAPER (Simulated)
TRADING_MODE=DEMO

# Delta Exchange India REST & WebSocket Endpoints
# Demo / Testnet (Recommended for testing):
DELTA_REST_URL_DEMO=https://cdn-ind.testnet.deltaex.org
DELTA_WS_URL_DEMO=wss://socket-ind.testnet.deltaex.org

# India Production:
DELTA_REST_URL_LIVE=https://api.india.delta.exchange
DELTA_WS_URL_LIVE=wss://socket.india.delta.exchange

# API Credentials (Generate in Delta Exchange Settings -> API Keys)
DELTA_API_KEY=your_delta_api_key_here
DELTA_API_SECRET=your_delta_api_secret_here

# Primary Trading Symbol (e.g. BTCUSD, BTCUSDT)
DEFAULT_SYMBOL=BTCUSD
DEFAULT_PRODUCT_ID=27

# ==========================================
# RISK MANAGEMENT SETTINGS (STRICT LIMITS)
# ==========================================
# Risk per trade: 0.25% of account equity
RISK_PER_TRADE_PCT=0.0025

# Daily loss limit: 1.0% of daily starting equity
DAILY_LOSS_LIMIT_PCT=0.01

# Maximum simultaneous open positions: 1
MAX_SIMULTANEOUS_POSITIONS=1

# Maximum allowable leverage: 25x
MAX_LEVERAGE=25

# Mandatory Stop-Loss & Take-Profit enforcement
REQUIRE_STOP_LOSS=true
REQUIRE_TAKE_PROFIT=true

# Circuit breaker: disable trading after repeated API errors
MAX_CONSECUTIVE_API_ERRORS=3

# Minimum Risk to Reward ratio
MIN_RISK_REWARD_RATIO=2.0
