# Autonomous Crypto Scalping System — Environment Configuration

# Execution Mode: BACKTEST | PAPER | LIVE
TRADING_MODE=PAPER

# Exchange API Credentials (NEVER commit live secrets)
EXCHANGE_NAME=binance
EXCHANGE_API_KEY=your_read_only_or_trade_api_key_here
EXCHANGE_API_SECRET=your_api_secret_here
EXCHANGE_API_PASSPHRASE=

# Security Constraints
WITHDRAWALS_DISABLED=true
READ_ONLY_MODE=false

# Risk & Capital Controls
ACCOUNT_CURRENCY=USDT
INITIAL_CAPITAL=10000.0
MAX_RISK_PER_TRADE_PCT=0.005  # 0.50%
MAX_DAILY_LOSS_PCT=0.015      # 1.50%
MAX_WEEKLY_LOSS_PCT=0.040     # 4.00%
MAX_OPEN_POSITIONS=2
MAX_LEVERAGE=3.0
MAX_SLIPPAGE_BPS=5.0          # 5 bps
MAX_SPREAD_BPS=4.0            # 4 bps
COOLDOWN_SECONDS=180

# Agent Consensus & Decision Thresholds
AGENT1_MIN_SCORE=80.0
AGENT2_MIN_SCORE=80.0
FUSED_CONFIDENCE_THRESHOLD=85.0
MIN_RISK_REWARD_RATIO=2.0
KELLY_FRACTION_MULTIPLIER=0.15

# Monitoring & Alerting
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
